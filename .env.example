# URL publique du site, sans barre oblique finale.
# Sert aux métadonnées absolues, au sitemap, au robots.txt et au balisage
# structuré. Valeur par défaut si absente : https://fresh-sweet-box.zaika.mg
NEXT_PUBLIC_SITE_URL=https://fresh-sweet-box.zaika.mg

# --- Chat (assistant du site) --------------------------------------------
# Clé de l'API Gemini, créée sur https://aistudio.google.com/apikey.
# SANS préfixe NEXT_PUBLIC_ : ce préfixe la publierait dans le bundle du
# navigateur. Elle n'est lue que par la route serveur `src/app/api/chat`.
# Si elle est absente, le bouton de chat ne s'affiche pas du tout.
GEMINI_API_KEY=

# Limitation de débit, via une base Redis Upstash (offre gratuite suffisante,
# intégration en un clic depuis le Marketplace Vercel).
# Sans ces deux variables le chat fonctionne, mais SANS protection : un seul
# visiteur — ou un robot — peut épuiser le quota gratuit de l'API pour tout
# le monde. À renseigner avant la mise en production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
